# Um conjunto destas variáveis por projeto na Vercel (um projeto por cliente, mais o adm). Nunca commitar valores.
# Modo do deploy: cliente (painel de uma clínica) ou adm (central Planee)
PAINEL_MODO=cliente
# Nome exibido do cliente neste deploy (ex.: Dr. Amilton)
PAINEL_CLIENTE_NOME=
# Supabase deste cliente. No deploy de teste, o Supabase de teste do painel (decisão 23).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Schema usado pelo painel (padrão: public no banco do cliente; teste enquanto não houver Supabase de teste)
NEXT_PUBLIC_SUPABASE_SCHEMA=teste
# Webhooks do n8n de teste (fase 2)
N8N_WEBHOOK_PAINEL_ENVIAR=
N8N_WEBHOOK_PAINEL_RETOMAR=
N8N_WEBHOOK_SEGREDO=

# Supabase do ambiente de teste (schema "teste"). Preencher em .env.local, nunca commitar.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Schema usado pelo painel enquanto estiver em teste
NEXT_PUBLIC_SUPABASE_SCHEMA=teste
# Webhooks do n8n de teste (fase 2)
N8N_WEBHOOK_PAINEL_ENVIAR=
N8N_WEBHOOK_PAINEL_RETOMAR=
N8N_WEBHOOK_SEGREDO=

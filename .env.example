# Variáveis do painel (um painel só para todas as empresas, decisão 26). Nunca commitar valores.
# Em produção ficam na stack do Portainer; localmente, no .env.local.
# Supabase deste cliente. No deploy de teste, o Supabase de teste do painel (decisão 23).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Schema usado pelo painel (padrão: public no banco do cliente; teste enquanto não houver Supabase de teste)
NEXT_PUBLIC_SUPABASE_SCHEMA=teste
# Banco padrão (connection pooler): dados das empresas sem banco próprio. Só o servidor usa.
DATABASE_URL=
# Banco central da Planee (empresas, domínios, pessoas, permissões). Vazio = o mesmo DATABASE_URL (teste).
CENTRAL_DATABASE_URL=
# Chave (32+ caracteres) que cifra o endereço do banco de cada empresa no banco central. Gerar uma vez e guardar.
PAINEL_CHAVE_CIFRA=
# Endereço do painel da Planee (não pode ser cadastrado como domínio de empresa). Padrão: adm.planeelabia.com
PAINEL_HOST_ADM=
# Login do painel: Supabase Auth do banco central (um login para todas as empresas). Só do servidor; a service_role NÃO é usada.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Fuso do "finalizados hoje" e das horas na tela (opcional)
PAINEL_FUSO=America/Sao_Paulo
# Webhooks do n8n de teste (fase 2)
N8N_WEBHOOK_PAINEL_ENVIAR=
N8N_WEBHOOK_PAINEL_RETOMAR=
N8N_WEBHOOK_SEGREDO=
